---
import TechStack from "./TechStack.astro";
---

<section class="hero">
    <div class="hero-stage">
        <div class="container hero-grid">
            <div class="hero-copy">
                <h1 class="heading-1 hero-title">
                    <span class="hero-line">Hey, I'm Vagno.</span>
                </h1>

                <p class="body-2 hero-lede">
                    I build Discord bots in TypeScript and JavaScript, and I am learning Rust by
                    writing a text editor.
                </p>

                <div class="hero-actions">
                    <a class="btn btn-primary button-md" href="#projects">
                        View projects
                        <span class="btn-arrow" aria-hidden="true">→</span>
                    </a>
                    <a class="btn btn-ghost button-md" href="#contact">Get in touch</a>
                </div>

                <a class="hero-now" href="#projects">
                    <span class="hero-now-inner">
                        <span class="caption-3 hero-now-label">Now</span>
                        <span class="caption-1">Building Rusk, a text editor in Rust</span>
                        <span class="hero-now-arrow" aria-hidden="true">→</span>
                    </span>
                </a>
            </div>

            <aside class="hero-panel reveal" aria-label="Profile and current focus">
                <div class="card profile-card">
                    <div class="profile-top">
                        <img
                            id="discord-avatar"
                            class="profile-avatar"
                            src="/vagno.ico"
                            width="64"
                            height="64"
                            alt="Discord avatar of Vagno"
                            draggable="false"
                        />
                        <div class="profile-meta">
                            <span id="discord-name" class="title-1">Vagno</span>
                            <span id="discord-handle" class="caption-2 profile-handle"
                                >@vagno.dev</span
                            >
                            <span id="discord-activity" class="caption-4 profile-activity" hidden
                            ></span>
                        </div>
                    </div>

                    <div id="discord-status" class="profile-status" hidden>
                        <span id="discord-status-dot" class="status-dot"></span>
                        <span id="discord-status-text" class="caption-2">Offline</span>
                    </div>

                    <hr class="hr" />

                    <div class="focus-row">
                        <span class="caption-3 focus-label">Focus</span>
                        <span class="title-3">Discord bots</span>
                    </div>
                    <div class="focus-row">
                        <span class="caption-3 focus-label">Learning</span>
                        <span class="title-3">Rust, open source</span>
                    </div>
                </div>
            </aside>
        </div>

        <div class="hero-skills">
            <TechStack />
        </div>
    </div>
</section>

<style>
    .hero {
        position: sticky;
        top: 0;
        z-index: 0;
        display: flex;
        height: 100vh;
        height: 100svh;
        background: var(--bg);
    }

    .hero-stage {
        position: relative;
        display: flex;
        flex: 1;
        flex-direction: column;
        min-width: 0;
        justify-content: center;
        padding-top: calc(var(--space-900) + var(--space-300));
        padding-bottom: calc(var(--space-800) + var(--space-500));
    }

    .hero-skills {
        position: absolute;
        inset-inline: 0;
        bottom: var(--space-400);
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: var(--space-700);
        align-items: center;
    }

    .hero-copy {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .hero-title {
        display: flex;
        flex-direction: column;
        font-size: clamp(38px, 7.5vw, 80px);
        line-height: 0.98;
        letter-spacing: -0.035em;
    }

    .hero-line {
        display: block;
    }

    .hero-lede {
        max-width: 560px;
        margin-top: var(--space-400);
        font-size: clamp(16px, 1.4vw, 18px);
        line-height: 1.55;
        color: var(--text-muted);
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-100);
        margin-top: var(--space-500);
    }

    .hero-now {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        margin-top: var(--space-500);
        color: var(--text-muted);
        transition: color var(--duration-300) var(--ease);
    }

    .hero-now-inner {
        display: inline-flex;
        align-items: center;
        gap: var(--space-100);
        padding-bottom: var(--space-50);
        border-bottom: 1px solid var(--line);
        transition: border-color var(--duration-300) var(--ease);
    }

    .hero-now-label {
        color: var(--text-muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .hero-now-arrow {
        display: inline-block;
        transition: transform var(--duration-300) var(--ease);
    }

    .hero-now:hover {
        color: var(--text);
    }

    .hero-now:hover .hero-now-inner {
        border-color: var(--line-strong);
    }

    .hero-now:hover .hero-now-arrow {
        transform: translateX(3px);
    }

    .hero-panel {
        display: flex;
        flex-direction: column;
        gap: var(--space-300);
    }

    .profile-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-200);
        background: #0c0c0c;
    }

    .profile-top {
        display: flex;
        align-items: center;
        gap: var(--space-200);
    }

    .profile-avatar {
        width: 72px;
        height: 72px;
        border-radius: var(--radius-pill);
        object-fit: cover;
        background: var(--surface-raised);
        flex-shrink: 0;
    }

    .profile-meta {
        display: flex;
        flex-direction: column;
        gap: var(--space-25);
        min-width: 0;
    }

    .profile-handle {
        color: var(--text-muted);
    }

    .profile-activity {
        color: var(--text-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .profile-activity[hidden],
    .profile-status[hidden] {
        display: none;
    }

    .profile-status {
        display: inline-flex;
        align-items: center;
        gap: var(--space-100);
        align-self: flex-start;
        padding: var(--space-50) var(--space-100);
        border: 1px solid var(--line);
        border-radius: var(--radius-pill);
    }

    .status-dot {
        width: var(--space-75);
        height: var(--space-75);
        border-radius: var(--radius-pill);
        background: var(--text-dim);
        transition: background-color var(--duration-300) var(--ease);
    }

    .status-dot.online {
        background: #22c55e;
    }

    .status-dot.idle {
        background: #eab308;
    }

    .status-dot.dnd {
        background: #ef4444;
    }

    .focus-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-200);
        padding-block: var(--space-75);
        border-bottom: 1px solid var(--line);
    }

    .focus-row:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .focus-label {
        color: var(--text-muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        flex-shrink: 0;
    }

    .focus-row .title-3 {
        color: var(--text-muted);
        text-align: right;
    }

    @media (min-height: 641px) {
        .hero-stage {
            transform: translateY(calc(var(--hero-p, 0) * -56px))
                scale(calc(1 - var(--hero-p, 0) * 0.045));
            opacity: calc(1 - var(--hero-p, 0) * 0.82);
            will-change: transform, opacity;
        }
    }

    @media (max-height: 640px) {
        .hero {
            position: relative;
            height: auto;
            min-height: 100vh;
            min-height: 100svh;
        }

        .hero-stage {
            padding-block: calc(var(--space-900) + var(--space-200)) var(--space-600);
        }

        .hero-skills {
            position: static;
            margin-top: var(--space-500);
        }
    }

    @media (max-width: 900px) {
        .hero-stage {
            padding-top: calc(var(--space-900) + var(--space-100));
            padding-bottom: calc(var(--space-800) + var(--space-400));
        }

        .hero-skills {
            bottom: var(--space-300);
        }

        .hero-grid {
            grid-template-columns: 1fr;
            gap: var(--space-500);
        }
    }

    @media (max-height: 640px) and (min-width: 640px) {
        .hero-grid {
            grid-template-columns: 1.1fr 0.9fr;
            gap: var(--space-500);
        }
    }

</style>

<script>
    const DISCORD_ID = "807558492633169960";
    const REFRESH_MS = 30000;
    const STATUS_LABELS: Record<string, string> = {
        online: "Online",
        idle: "Idle",
        dnd: "Do not disturb",
        offline: "Offline",
    };

    const avatarEl = document.getElementById("discord-avatar") as HTMLImageElement;
    const nameEl = document.getElementById("discord-name") as HTMLElement;
    const handleEl = document.getElementById("discord-handle") as HTMLElement;
    const activityEl = document.getElementById("discord-activity") as HTMLElement;
    const statusEl = document.getElementById("discord-status") as HTMLElement;
    const statusDotEl = document.getElementById("discord-status-dot") as HTMLElement;
    const statusTextEl = document.getElementById("discord-status-text") as HTMLElement;

    const avatarUrl = (user: { id: string; avatar: string | null }) => {
        if (user.avatar) {
            const ext = user.avatar.startsWith("a_") ? "gif" : "png";
            return `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.${ext}?size=256`;
        }
        const index = Number((BigInt(user.id) >> BigInt(22)) % BigInt(6));
        return `https://cdn.discordapp.com/embed/avatars/${index}.png`;
    };

    const renderProfile = (data: any) => {
        const user = data.discord_user;
        const status: string = data.discord_status ?? "offline";
        const custom = (data.activities ?? []).find((activity: any) => activity.type === 4);

        avatarEl.src = avatarUrl(user);
        avatarEl.alt = `Discord avatar of ${user.global_name || user.username}`;
        nameEl.textContent = user.global_name || user.username;
        handleEl.textContent = `@${user.username}`;

        if (custom?.state) {
            activityEl.textContent = custom.state;
            activityEl.hidden = false;
        } else {
            activityEl.hidden = true;
        }

        statusDotEl.className = `status-dot ${status}`;
        statusTextEl.textContent = STATUS_LABELS[status] ?? "Offline";
        statusEl.hidden = false;
    };

    const loadDiscordProfile = async () => {
        try {
            const response = await fetch(`https://api.lanyard.rest/v1/users/${DISCORD_ID}`);
            if (!response.ok) return;
            const json = await response.json();
            if (json.success) renderProfile(json.data);
        } catch {
            statusEl.hidden = true;
        }
    };

    loadDiscordProfile();
    setInterval(loadDiscordProfile, REFRESH_MS);

    const hero = document.querySelector<HTMLElement>(".hero");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let frame = 0;

    const paintHero = () => {
        frame = 0;
        if (!hero) return;
        const travel = hero.offsetHeight * 0.9;
        const progress = Math.min(1, Math.max(0, window.scrollY / (travel || 1)));
        hero.style.setProperty("--hero-p", progress.toFixed(3));
    };

    const schedulePaint = () => {
        if (!frame) frame = requestAnimationFrame(paintHero);
    };

    if (hero && !reduced) {
        paintHero();
        window.addEventListener("scroll", schedulePaint, { passive: true });
        window.addEventListener("resize", schedulePaint);
    }
</script>
