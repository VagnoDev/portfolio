</style>

<script>
    const DISCORD_ID = "807558492633169960";
    const REFRESH_MS = 30000;
    const STATUS_LABELS: Record<string, string> = {
        online: "Online",
        idle: "Idle",
        dnd: "Do not disturb",
        offline: "Offline",
    };

    const avatarEl = document.getElementById("discord-avatar") as HTMLImageElement;
    const nameEl = document.getElementById("discord-name") as HTMLElement;
    const handleEl = document.getElementById("discord-handle") as HTMLElement;
    const activityEl = document.getElementById("discord-activity") as HTMLElement;
    const statusEl = document.getElementById("discord-status") as HTMLElement;
    const statusDotEl = document.getElementById("discord-status-dot") as HTMLElement;
    const statusTextEl = document.getElementById("discord-status-text") as HTMLElement;

    const avatarUrl = (user: { id: string; avatar: string | null }) => {
        if (user.avatar) {
            const ext = user.avatar.startsWith("a_") ? "gif" : "png";
            return `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.${ext}?size=256`;
        }
        const index = Number((BigInt(user.id) >> BigInt(22)) % BigInt(6));
        return `https://cdn.discordapp.com/embed/avatars/${index}.png`;
    };

    const renderProfile = (data: any) => {
        const user = data.discord_user;
        const status: string = data.discord_status ?? "offline";
        const custom = (data.activities ?? []).find((activity: any) => activity.type === 4);

        avatarEl.src = avatarUrl(user);
        avatarEl.alt = `Discord avatar of ${user.global_name || user.username}`;
        nameEl.textContent = user.global_name || user.username;
        handleEl.textContent = `@${user.username}`;

        if (custom?.state) {
            activityEl.textContent = custom.state;
            activityEl.hidden = false;
        } else {
            activityEl.hidden = true;
        }

        statusDotEl.className = `status-dot ${status}`;
        statusTextEl.textContent = STATUS_LABELS[status] ?? "Offline";
        statusEl.hidden = false;
    };

    const loadDiscordProfile = async () => {
        try {
            const response = await fetch(`https://api.lanyard.rest/v1/users/${DISCORD_ID}`);
            if (!response.ok) return;
            const json = await response.json();
            if (json.success) renderProfile(json.data);
        } catch {
            statusEl.hidden = true;
        }
    };

    loadDiscordProfile();
    setInterval(loadDiscordProfile, REFRESH_MS);
</script>
