<style>
    .hero {
        padding-top: calc(var(--space-900) + var(--space-600));
        padding-bottom: var(--space-900);
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: var(--space-800);
        align-items: center;
    }

    .hero-copy {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .hero-title {
        margin-top: var(--space-300);
        display: flex;
        flex-direction: column;
    }

    .hero-line {
        background-image: linear-gradient(90deg, #ffffff 0%, #9b9b9b 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .hero-lede {
        max-width: 680px;
        margin-top: var(--space-300);
        color: var(--text-muted);
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-100);
        margin-top: var(--space-400);
    }

    .hero-facts {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-500);
        margin-top: var(--space-600);
        padding-top: var(--space-300);
        border-top: 1px solid var(--line);
        width: 100%;
    }

    .hero-facts div {
        display: flex;
        flex-direction: column;
        gap: var(--space-50);
    }

    .hero-facts dt {
        color: var(--text-muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .hero-facts dd {
        color: var(--text-muted);
    }

    .hero-panel {
        display: flex;
        flex-direction: column;
        gap: var(--space-300);
    }

    .profile-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-200);
    }

    .profile-top {
        display: flex;
        align-items: center;
        gap: var(--space-200);
    }

    .profile-avatar {
        width: 64px;
        height: 64px;
        border-radius: var(--radius-pill);
        object-fit: cover;
        background: var(--surface-raised);
        flex-shrink: 0;
    }

    .profile-meta {
        display: flex;
        flex-direction: column;
        gap: var(--space-25);
        min-width: 0;
    }

    .profile-handle {
        color: var(--text-muted);
    }

    .profile-activity {
        color: var(--text-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .profile-activity[hidden],
    .profile-status[hidden] {
        display: none;
    }

    .profile-status {
        display: inline-flex;
        align-items: center;
        gap: var(--space-100);
        align-self: flex-start;
        padding: var(--space-50) var(--space-100);
        border: 1px solid var(--line);
