---
---

<section id="projects" class="projects-section">
    <div class="container">
        <div class="section-header">
            <h2>Featured <span class="gradient-text">Projects</span></h2>
            <p>Some of the things I've built while learning.</p>
        </div>

        <article class="project fade-in">
            <h3>Rusk</h3>
            <p>
                A small Rust project where I'm building my own personal text editor, inspired by Vim.
                I'm still learning Rust, so this is how I practice, try new ideas, and get better while
                making something useful.
            </p>
            <a
                href="https://github.com/VagnoDev/Rusk"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-secondary project-btn"
            >
                <i class="fa-brands fa-github"></i>
                View on GitHub
            </a>
        </article>
    </div>
</section>

<style>
    .projects-section {
        padding: 6rem 0;
    }

    .project {
        max-width: 720px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
        background: #0c0c0f;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 2.8rem;
    }

    .project h3 {
        font-size: 2.2rem;
        font-weight: 800;
        letter-spacing: -0.8px;
        line-height: 1.2;
        color: #ffffff;
    }

    .project p {
        color: var(--text-secondary);
        font-size: 1.05rem;
        line-height: 1.75;
        margin-bottom: 0.8rem;
    }

    .project-btn {
        min-height: 44px;
        padding: 0.85rem 1.6rem;
        font-size: 0.95rem;
        gap: 0.6rem;
    }

    @media (max-width: 768px) {
        .project {
            padding: 1.75rem;
        }

        .project h3 {
            font-size: 1.85rem;
        }

        .project-btn {
            width: 100%;
        }
    }
</style>
