<style>
    nav {
        padding: 2rem 0;
        position: fixed;
        width: 100%;
        top: 0;
        z-index: 1000;
        transition: 0.3s;
    }

    nav.scrolled {
        background: rgba(5, 5, 5, 0.95);
        border-bottom: 1px solid var(--card-border);
    }

    .nav-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo {
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .dot {
        color: var(--text-secondary);
    }

    .nav-links {
        display: flex;
        gap: 3rem;
        align-items: center;
    }

    .nav-links a {
        color: var(--text-secondary);
        font-weight: 500;
        font-size: 0.95rem;
        position: relative;
    }

    .nav-links a:hover {
        color: var(--text-primary);
    }

    .nav-links a::after {
        content: '';
        position: absolute;
        width: 0;
        height: 1px;
        bottom: -4px;
        left: 0;
        background: white;
        transition: 0.3s;
    }

    .nav-links a:hover::after {
        width: 100%;
    }

    .btn-nav {
        padding: 0.6rem 1.5rem;
        background: white;
        color: black !important;
        border-radius: 50px;
        font-weight: 600;
    }

    .btn-nav:hover {
        background: #e4e4e7;
    }

    .btn-nav::after {
        display: none;
    }

    @media (max-width: 968px) {
        nav {
            padding: calc(env(safe-area-inset-top, 0px) + 0.9rem) 0 0.6rem;
            background: rgba(5, 5, 5, 0.96);
            border-bottom: 1px solid var(--card-border);
        }

        .nav-content {
            flex-direction: column;
            align-items: center;
            gap: 0.6rem;
        }

        .nav-links {
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.6rem 1.25rem;
        }

        .nav-links a {
            display: inline-flex;
            align-items: center;
            min-height: 44px;
            padding: 0 0.4rem;
        }

        .nav-links a::after {
