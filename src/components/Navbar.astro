<header class="site-header">
    <nav class="nav" aria-label="Main">
        <a class="brand" href="#top">
            vagno<span class="brand-dot">.</span>dev
        </a>

        <ul class="nav-links">
            <li><a href="#about" data-section="about">About</a></li>
            <li><a href="#skills" data-section="skills">Skills</a></li>
            <li><a href="#projects" data-section="projects">Projects</a></li>
        </ul>

        <a class="nav-cta button-sm" href="#contact">Get in touch</a>

        <button
            class="nav-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="site-menu"
        >
            <span></span>
            <span></span>
        </button>
    </nav>

    <div class="menu" id="site-menu" aria-hidden="true">
        <nav class="menu-links" aria-label="Sections">
            <a href="#about" style="--i: 0"><span class="menu-index">01</span>About</a>
            <a href="#skills" style="--i: 1"><span class="menu-index">02</span>Skills</a>
            <a href="#projects" style="--i: 2"><span class="menu-index">03</span>Projects</a>
            <a href="#contact" style="--i: 3"><span class="menu-index">04</span>Contact</a>
        </nav>
        <div class="menu-foot">
            <a class="caption-2" href="mailto:contact@vagno.dev">contact@vagno.dev</a>
            <span class="caption-2 menu-note">Discord bots, web tools, Rust</span>
        </div>
    </div>
</header>

<style>
    .site-header {
        position: fixed;
        inset-inline: 0;
        top: var(--space-200);
        z-index: 100;
        display: flex;
        justify-content: center;
        pointer-events: none;
    }

    .nav {
        position: relative;
        z-index: 2;
        pointer-events: auto;
        display: flex;
        align-items: center;
        gap: var(--space-400);
        width: min(var(--container), calc(100% - var(--space-400)));
        padding: var(--space-75) var(--space-75) var(--space-75) var(--space-300);
        border: 1px solid var(--line);
        border-radius: var(--radius-pill);
        background: rgba(18, 18, 18, 0.72);
        backdrop-filter: blur(24px) saturate(140%);
        -webkit-backdrop-filter: blur(24px) saturate(140%);
    }

    .brand {
        font-size: 18px;
        line-height: 28px;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin-right: auto;
    }

    .brand-dot {
        color: var(--text-dim);
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: var(--space-300);
    }

    .nav-links a {
        position: relative;
        display: inline-flex;
        align-items: center;
        height: 32px;
        font-size: 14px;
        line-height: 20px;
        font-weight: 500;
        color: var(--text-muted);
        transition: color var(--duration-300) var(--ease);
    }

    .nav-links a::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 0;
        width: var(--space-50);
        height: var(--space-50);
        border-radius: var(--radius-pill);
        background: var(--text);
        opacity: 0;
        transform: translate(-50%, var(--space-50)) scale(0.6);
        transition: opacity var(--duration-300) var(--ease),
            transform var(--duration-300) var(--ease);
    }

    .nav-links a:hover,
    .nav-links a[aria-current="true"] {
        color: var(--text);
    }

    .nav-links a[aria-current="true"]::after {
        opacity: 1;
        transform: translate(-50%, 0) scale(1);
    }

    .nav-cta {
        padding: var(--space-75) var(--space-200);
        border-radius: var(--radius-pill);
        background: var(--text);
        color: var(--bg);
        transition: background-color var(--duration-300) var(--ease),
            transform var(--duration-300) var(--ease);
    }

    .nav-cta:hover {
        background: #e4e4e7;
    }

    .nav-cta:active {
        transform: scale(0.98);
    }

    .nav-toggle {
        position: relative;
        display: none;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: var(--radius-pill);
        border: 1px solid var(--line);
    }

    .nav-toggle span {
        position: absolute;
        width: 18px;
        height: 1.5px;
        border-radius: var(--radius-pill);
        background: var(--text);
        transition: transform var(--duration-500) var(--ease);
    }

    .nav-toggle span:first-child {
        transform: translateY(-4px);
    }

    .nav-toggle span:last-child {
        transform: translateY(4px);
    }

    .nav-toggle[aria-expanded="true"] span:first-child {
        transform: rotate(45deg) translateY(0);
    }

    .nav-toggle[aria-expanded="true"] span:last-child {
        transform: rotate(-45deg) translateY(0);
    }

    .menu {
        position: fixed;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: var(--space-700);
        padding: var(--space-900) var(--space-300) var(--space-600);
        background: rgba(0, 0, 0, 0.9);
        backdrop-filter: blur(28px);
        -webkit-backdrop-filter: blur(28px);
        opacity: 0;
        visibility: hidden;
        transition: opacity var(--duration-500) var(--ease),
            visibility var(--duration-500) var(--ease);
    }

    .menu.is-open {
        pointer-events: auto;
        opacity: 1;
        visibility: visible;
    }

    .menu-links {
        display: flex;
        flex-direction: column;
        gap: var(--space-100);
    }

    .menu-links a {
        display: flex;
        align-items: baseline;
        gap: var(--space-200);
        padding-block: var(--space-75);
        font-size: 30px;
        line-height: 36px;
        font-weight: 600;
        letter-spacing: -0.02em;
        opacity: 0;
        transform: translateY(var(--space-300));
        transition: opacity var(--duration-500) var(--ease),
            transform var(--duration-500) var(--ease);
    }

    .menu.is-open .menu-links a {
        opacity: 1;
        transform: none;
        transition-delay: calc(var(--i) * 60ms);
    }

    .menu-index {
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 16px;
        font-weight: 500;
        color: var(--text-muted);
    }

    .menu-foot {
        display: flex;
        flex-direction: column;
        gap: var(--space-75);
        color: var(--text-muted);
        opacity: 0;
        transition: opacity var(--duration-500) var(--ease);
    }

    .menu.is-open .menu-foot {
        opacity: 1;
        transition-delay: 260ms;
    }

    .menu-note {
        font-family: var(--font-mono);
        color: var(--text-dim);
    }

    @media (max-width: 900px) {
        .nav {
            gap: var(--space-200);
            padding: var(--space-75) var(--space-75) var(--space-75) var(--space-200);
        }

        .nav-links,
        .nav-cta {
            display: none;
        }

        .nav-toggle {
            display: flex;
        }
    }
</style>

<script>
    const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const menu = document.getElementById("site-menu");

    const setMenu = (open: boolean) => {
        if (!toggle || !menu) return;
        const wasOpen = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        menu.setAttribute("aria-hidden", String(!open));
        menu.classList.toggle("is-open", open);
        document.documentElement.style.overflow = open ? "hidden" : "";
        if (!open && wasOpen) toggle.focus({ preventScroll: true });
    };

    toggle?.addEventListener("click", () => {
        setMenu(toggle.getAttribute("aria-expanded") !== "true");
    });

    document.querySelectorAll(".menu a").forEach((link) => {
        link.addEventListener("click", () => setMenu(false));
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenu(false);
    });

    const desktop = window.matchMedia("(min-width: 901px)");
    desktop.addEventListener("change", (event) => {
        if (event.matches) setMenu(false);
    });

    const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(".nav-links a[data-section]"),
    );

    const spy = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const id = entry.target.id;
                links.forEach((link) => {
                    if (link.dataset.section === id) {
                        link.setAttribute("aria-current", "true");
                    } else {
                        link.removeAttribute("aria-current");
                    }
                });
            });
        },
        { rootMargin: "-48% 0px -48% 0px" },
    );

    links.forEach((link) => {
        const section = document.getElementById(link.dataset.section ?? "");
        if (section) spy.observe(section);
    });
</script>
