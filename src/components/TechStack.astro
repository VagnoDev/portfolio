---
const tech = [
    { name: "TypeScript", icon: "typescript/typescript-original" },
    { name: "JavaScript", icon: "javascript/javascript-original" },
    { name: "Node.js", icon: "nodejs/nodejs-original" },
    { name: "Discord.js", icon: "discordjs/discordjs-original" },
    { name: "MongoDB", icon: "mongodb/mongodb-original" },
    { name: "MySQL", icon: "mysql/mysql-original" },
    { name: "Go", icon: "go/go-original-wordmark" },
    { name: "HTML5", icon: "html5/html5-original" },
    { name: "CSS3", icon: "css3/css3-original" },
];

const items = [...tech, ...tech];
const groups = [0, 1];
---

<div class="skills" role="group" aria-label="Languages and tools">
    <div class="marquee">
        <div class="marquee-track">
            {
                groups.map((group) => (
                    <div class="marquee-group" aria-hidden={group === 1 ? "true" : undefined}>
                        {items.map((item) => (
                            <div class="marquee-item">
                                <img
                                    src={`https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${item.icon}.svg`}
                                    width="16"
                                    height="16"
                                    alt=""
                                    draggable="false"
                                />
                                <span class="caption-1">{item.name}</span>
                            </div>
                        ))}
                    </div>
                ))
            }
        </div>
    </div>
</div>

<style>
    .skills {
        width: 100%;
        max-width: var(--container);
        margin-inline: auto;
        padding-inline: var(--space-300);
        overflow: hidden;
    }

    .marquee {
        overflow: hidden;
        padding-block: var(--space-100);
        mask-image: linear-gradient(to right, transparent, #000 14%, #000 86%, transparent);
        -webkit-mask-image: linear-gradient(
            to right,
            transparent,
            #000 14%,
            #000 86%,
            transparent
        );
    }

    .marquee-track {
        display: flex;
        width: max-content;
        animation: drift 46s linear infinite;
    }

    .skills:hover .marquee-track {
        animation-play-state: paused;
    }

    .marquee-group {
        display: flex;
        gap: var(--space-600);
        padding-right: var(--space-600);
    }

    .marquee-item {
        display: inline-flex;
        align-items: center;
        gap: var(--space-75);
        color: var(--text-muted);
        white-space: nowrap;
        transition: color var(--duration-300) var(--ease);
    }

    .marquee-item img {
        width: 16px;
        height: 16px;
        filter: grayscale(1) opacity(0.5);
        transition: filter var(--duration-300) var(--ease);
    }

    .marquee-item:hover {
        color: var(--text);
    }

    .marquee-item:hover img {
        filter: grayscale(0) opacity(1);
    }

    @keyframes drift {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee {
            mask-image: none;
            -webkit-mask-image: none;
        }

        .marquee-track {
            width: 100%;
            animation: none;
        }

        .marquee-group {
            flex-wrap: wrap;
            justify-content: center;
            gap: var(--space-200) var(--space-400);
            padding-right: 0;
        }

        .marquee-group[aria-hidden="true"] {
            display: none;
        }
    }
</style>
