---
const tech = [
    { name: "TypeScript", icon: "typescript/typescript-original" },
    { name: "JavaScript", icon: "javascript/javascript-original" },
    { name: "Node.js", icon: "nodejs/nodejs-original" },
    { name: "Discord.js", icon: "discordjs/discordjs-original" },
    { name: "MongoDB", icon: "mongodb/mongodb-original" },
    { name: "MySQL", icon: "mysql/mysql-original" },
    { name: "Go", icon: "go/go-original-wordmark" },
    { name: "HTML5", icon: "html5/html5-original" },
    { name: "CSS3", icon: "css3/css3-original" },
];

const items = [...tech, ...tech];
const groups = [0, 1];
---

<section id="skills" class="section stack-section">
    <div class="container">
        <div class="section-head reveal">
            <p class="eyebrow">02 · Stack</p>
            <h2 class="heading-2">
                The tools I reach for <span class="heading-soft">without thinking.</span>
            </h2>
        </div>
    </div>

    <div class="marquee">
        <div class="marquee-track">
            {
                groups.map((group) => (
                    <div class="marquee-group" aria-hidden={group === 1 ? "true" : undefined}>
                        {items.map((item) => (
                            <div class="marquee-item">
                                <img
                                    src={`https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${item.icon}.svg`}
                                    width="22"
                                    height="22"
                                    alt=""
                                    loading="lazy"
                                    draggable="false"
                                />
                                <span class="caption-1">{item.name}</span>
                            </div>
                        ))}
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .stack-section {
        padding-bottom: 0;
    }

    .marquee {
        overflow: hidden;
        margin-top: var(--space-700);
        padding-block: var(--space-300);
        border-block: 1px solid var(--line);
        mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
        -webkit-mask-image: linear-gradient(
            to right,
            transparent,
            #000 12%,
            #000 88%,
            transparent
        );
    }

    .marquee-track {
        display: flex;
        width: max-content;
        animation: drift 46s linear infinite;
    }

    .marquee:hover .marquee-track {
        animation-play-state: paused;
    }

    .marquee-group {
        display: flex;
        gap: var(--space-600);
        padding-right: var(--space-600);
    }

    .marquee-item {
        display: inline-flex;
        align-items: center;
        gap: var(--space-100);
        padding: var(--space-75) var(--space-200);
        border: 1px solid var(--line);
        border-radius: var(--radius-pill);
        color: var(--text-muted);
        white-space: nowrap;
        transition: border-color var(--duration-300) var(--ease),
            color var(--duration-300) var(--ease);
    }

    .marquee-item img {
        width: 22px;
        height: 22px;
        filter: grayscale(1) opacity(0.65);
        transition: filter var(--duration-300) var(--ease);
    }

    .marquee-item:hover {
        border-color: var(--line-strong);
        color: var(--text);
    }

    .marquee-item:hover img {
        filter: grayscale(0) opacity(1);
    }

    @keyframes drift {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee {
            mask-image: none;
            -webkit-mask-image: none;
        }

        .marquee-track {
            width: 100%;
            animation: none;
        }

        .marquee-group {
            flex-wrap: wrap;
            justify-content: center;
            gap: var(--space-200);
            padding-right: 0;
        }

        .marquee-group[aria-hidden="true"] {
            display: none;
        }
    }
</style>
