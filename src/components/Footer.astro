---
import { Image } from "astro:assets";
import astroLogo from "../assets/astro-logo-light.svg";
---

<footer class="footer">
    <div class="container footer-inner">
        <p class="caption-2 footer-copy">© {new Date().getFullYear()} Vagno</p>

        <div class="footer-links">
            <a
                class="caption-2 footer-link astro-link"
                href="https://astro.build"
                target="_blank"
                rel="noopener noreferrer"
            >
                Built with
                <Image src={astroLogo} alt="Astro" width={16} height={16} draggable="false" />
                Astro
            </a>
            <a
                class="caption-2 footer-link"
                href="https://github.com/VagnoDev/portfolio"
                target="_blank"
                rel="noopener noreferrer"
            >
                Source code
            </a>
            <a class="caption-2 footer-link" href="#main">Back to top ↑</a>
        </div>
    </div>
</footer>

<style>
    .footer {
        position: relative;
        z-index: 1;
        background: var(--bg);
        border-top: 1px solid var(--line);
        padding-block: var(--space-400);
    }

    .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-200);
    }

    .footer-copy {
        color: var(--text-muted);
    }

    .footer-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-300);
    }

    .footer-link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-50);
        padding-block: var(--space-100);
        color: var(--text-muted);
        transition: color var(--duration-300) var(--ease);
    }

    .footer-link:hover {
        color: var(--text);
    }

    @media (max-width: 700px) {
        .footer-inner {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
